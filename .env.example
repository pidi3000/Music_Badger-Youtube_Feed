# Copy to .env and fill in real values before running docker-compose.
# See README.md for details on each setting.

# --- Required ---

# The password gating the whole app (single shared secret, no user accounts).
APP_ACCESS_SECRET=change-me

# Symmetric key used to encrypt API keys and the YouTube refresh token at
# rest. Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Key used to sign the session cookie. Any long random string.
SESSION_SECRET=change-me-too

# --- Database (pick one) ---

# SQLite (default, no separate DB service needed):
DATABASE_URL=sqlite+aiosqlite:////app/data/app.db

# PostgreSQL (used by the `db` service in docker-compose.yml):
# DATABASE_URL=postgresql+asyncpg://music_badger:music_badger@db:5432/music_badger

# --- Optional ---

SYNC_INTERVAL_MINUTES=30
BACKFILL_WORKER_INTERVAL_SECONDS=60

# YouTube OAuth client (create one in Google Cloud Console, YouTube Data
# API v3 enabled). Leave unset to run without subscription auto-import —
# manual channel add/tagging and RSS-based uploads still work without it,
# but you'll need at least one Data API key added in Settings for manual
# add and for `api`-mode upload fetching.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# Must exactly match an authorized redirect URI on the OAuth client.
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:8000/api/youtube/auth/callback
